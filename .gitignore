# Local source data
data/raw/*
!data/raw/.gitkeep
!data/source.yaml

# Local secrets and environment overrides
.env
.env.*
!.env.example
*.env
local.env

# Generated artifacts
artifacts/*
!artifacts/.gitkeep

# Local model files
models/**
!models/.gitkeep

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Browser and session state
browser_state/
session_state/
.codex/browser_state/

# macOS
.DS_Store

# Common video formats
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm
*.mpg
*.mpeg

# Common model weights
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.bin
*.weights
*.tflite

# Local source metadata
*.youtube.json
*.info.json
