{
  "name": "final-review-frontend",
  "version": "1.5.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate:api-types && tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "lint": "eslint .",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
